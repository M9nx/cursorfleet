{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "python3 .cursor/hooks/capture_hook.py sessionStart",
        "timeout": 10
      }
    ],
    "sessionEnd": [
      {
        "command": "python3 .cursor/hooks/capture_hook.py sessionEnd",
        "timeout": 10
      }
    ],
    "preToolUse": [
      {
        "command": "python3 .cursor/hooks/capture_hook.py preToolUse",
        "timeout": 10
      }
    ],
    "postToolUse": [
      {
        "command": "python3 .cursor/hooks/capture_hook.py postToolUse",
        "timeout": 10
      }
    ],
    "postToolUseFailure": [
      {
        "command": "python3 .cursor/hooks/capture_hook.py postToolUseFailure",
        "timeout": 10
      }
    ],
    "subagentStart": [
      {
        "command": "python3 .cursor/hooks/capture_hook.py subagentStart",
        "timeout": 10
      }
    ],
    "subagentStop": [
      {
        "command": "python3 .cursor/hooks/capture_hook.py subagentStop",
        "timeout": 10
      }
    ],
    "beforeShellExecution": [
      {
        "command": "python3 .cursor/hooks/capture_hook.py beforeShellExecution",
        "timeout": 10
      }
    ],
    "afterShellExecution": [
      {
        "command": "python3 .cursor/hooks/capture_hook.py afterShellExecution",
        "timeout": 10
      }
    ],
    "afterFileEdit": [
      {
        "command": "python3 .cursor/hooks/capture_hook.py afterFileEdit",
        "timeout": 10
      }
    ],
    "preCompact": [
      {
        "command": "python3 .cursor/hooks/capture_hook.py preCompact",
        "timeout": 10
      }
    ],
    "stop": [
      {
        "command": "python3 .cursor/hooks/capture_hook.py stop",
        "timeout": 10
      }
    ]
  }
}
